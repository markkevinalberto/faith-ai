{
  "expo": {
    "name": "FAITH AI",
    "slug": "faith-ai",
    "owner": "blessedinfinitum",
    "description": "FAITH AI — Family Assistant for Illness, Treatment & Health. A private, offline-first companion for managing diabetes, high blood pressure and other long-term conditions, with on-device AI.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "faithai",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F5FF",
    "ios": {
      "bundleIdentifier": "com.faithai.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.faithai.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#EDEBFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0F1022",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B4FE0",
          "defaultChannel": "dose-reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow FAITH AI to use Face ID to unlock your health records."
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.rnllama.** { *; }",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1bdadd8-6b1e-49b9-bb14-c944c98b6a41"
      }
    }
  }
}
